# Stage 1: Build the Go application
FROM golang:1.22-alpine AS builder

WORKDIR /app

# Copy go.mod and go.sum (if exists)
COPY go.mod go.sum ./

# Download all dependencies
RUN go mod download

# Copy the source code
COPY . .

# Set environment variables for static build
ENV CGO_ENABLED=0 GOOS=linux

# Build the binary
RUN go build -o main .

# Stage 2: Create a minimal image using distroless
FROM gcr.io/distroless/static-debian12 AS final

# Copy only the compiled binary from stage 1
COPY --from=builder /app/main /main

# Set the non-root user (uid 65532)
USER 65532:65532

# Expose the application port
EXPOSE 8080

# Command to run the application
CMD ["/main"]

# Stage 1: Build the Go application
FROM golang:1.22-alpine AS builder

WORKDIR /app

# Copy go.mod and go.sum (if exists)
COPY go.mod go.sum ./

# Download all dependencies
RUN go mod download

# Copy the source code
COPY . .

# Set environment variables for static build
ENV CGO_ENABLED=0 GOOS=linux

# Build the binary
RUN go build -o main .

# Stage 2: Create a minimal image using scratch (not recommended for production)
FROM scratch AS final

# Copy only the compiled binary from stage 1
COPY --from=builder /app/main /main

# Set the non-root user (uid 65532)
USER 65532:65532

# Expose the application port
EXPOSE 8080

# Command to run the application
CMD ["/main"]

Please note that using `scratch` as a base image is not recommended for production environments due to its lack of system libraries and utilities. The distroless images provide a more secure and minimal environment with only the necessary dependencies, which is why they are preferred for production use.